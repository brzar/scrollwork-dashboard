# ---------------------------------------------------------------------------
# Supabase — required
# Project Settings → API in the Supabase dashboard.
# ---------------------------------------------------------------------------
# Anon URL + key are baked into the client bundle — that's intentional. RLS
# policies enforce all access control, so the anon key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service-role key. SERVER-ONLY. NEVER prefix with NEXT_PUBLIC_.
# Bypasses RLS. Used only for admin operations (user invites, audit log,
# scheduled cache refresh).
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---------------------------------------------------------------------------
# Megaphone — required
# https://developer.megaphone.fm/  (Token issued by Megaphone support.)
# ---------------------------------------------------------------------------
# Never prefix with NEXT_PUBLIC_. The Megaphone token is used server-side only.
# Account 1 ("primary").
MEGAPHONE_API_TOKEN="put-your-megaphone-token-here"
MEGAPHONE_NETWORK_ID="your-network-uuid"
# MEGAPHONE_LABEL="Scrollwork"   # optional display name

# Account 2 ("secondary") — set these to combine a second Megaphone login.
# Leave blank to run single-account.
# MEGAPHONE_API_TOKEN_2="second-account-token"
# MEGAPHONE_NETWORK_ID_2="second-account-network-uuid"
# MEGAPHONE_LABEL_2="Viewly"     # optional display name

# Optional override; defaults to https://cms.megaphone.fm/api
# MEGAPHONE_API_BASE="https://cms.megaphone.fm/api"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL of the deployed app (used for OAuth redirect, audit context).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bootstrap super-admin: the first user with this email to sign in is
# promoted to super_admin automatically. Leave blank in prod after bootstrap.
SUPER_ADMIN_BOOTSTRAP_EMAIL=""

# ---------------------------------------------------------------------------
# Optional: shared secret for the metrics-cache cron endpoint
# (POST /api/admin/sync). If unset, the endpoint requires super_admin auth.
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Spotify Poster (admin tab → /admin/poster)
# Connects the dashboard to the Megaphone Poster (the YouTube → Megaphone
# tool). The Poster runs on a machine behind a Cloudflare tunnel to its web
# UI (port 8765); the dashboard proxies admin requests to it with a shared
# bearer token kept server-side. Leave blank to hide/disable the feature.
# ---------------------------------------------------------------------------
# Public tunnel URL pointing at the Poster's web UI.
POSTER_API_URL=""
# Shared secret — must EXACTLY match POSTER_API_TOKEN in the Poster's .env.
# Generate with: openssl rand -hex 32
POSTER_API_TOKEN=""
